# Host Nginx terminating TLS in front of ATT&CKWISE (mode ATTACKWISE_TLS=proxy, the default).
# Replace <your-domain> and the certificate paths, e.g. from certbot:
#   sudo cp nginx-host.conf.example /etc/nginx/sites-available/attackwise
#   sudo ln -s /etc/nginx/sites-available/attackwise /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# The stack listens on 127.0.0.1:8080 (ATTACKWISE_HTTP_BIND / ATTACKWISE_HTTP_PORT).

server {
    listen 80;
    listen [::]:80;
    server_name <your-domain>;
    # certbot --webroot can keep using /.well-known/acme-challenge/ here if needed.
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <your-domain>;

    ssl_certificate     /etc/letsencrypt/live/<your-domain>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<your-domain>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Start short; raise to 31536000 after HTTPS is confirmed for the whole domain.
    add_header Strict-Transport-Security "max-age=86400" always;

    client_max_body_size 16k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        # Required headers:
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        # The first request for a new ATT&CK release downloads it (~55 MB) from GitHub.
        proxy_read_timeout 300s;
        # Stream large API responses instead of buffering them on disk.
        proxy_buffering off;
    }
}
