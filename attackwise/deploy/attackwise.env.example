# ATT&CKWISE server configuration (template). `./attackwise.sh init` copies it to the config
# file (default /opt/attackwise/config/attackwise.env, mode 600) and fills APP_KEY once.
# Keep that file OUTSIDE the release directory and back it up; never commit or ship it.
# Values marked <…> are for the server owner to replace.

# --- Laravel ---------------------------------------------------------------------------------
APP_NAME=ATT&CKWISE
# Generated once by `./attackwise.sh init`. Do not change it on updates or restarts.
APP_KEY=
# Public address of the site, e.g. https://attackwise.example.org (used for logs/links only).
APP_URL=<https://your-domain>
LOG_LEVEL=warning
# APP_ENV=production and APP_DEBUG=false are enforced by compose.yaml.

# --- ATT&CK data (read-only API) ------------------------------------------------------------
# Official collection index and the only hosts the server may download from (https only).
ATTACKWISE_COLLECTION_INDEX_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/index.json
ATTACKWISE_ALLOWED_HOSTS=raw.githubusercontent.com
ATTACKWISE_INDEX_TTL=3600
ATTACKWISE_UPSTREAM_TIMEOUT=60
ATTACKWISE_MAX_BUNDLE_BYTES=209715200
# The cache lives in the Docker volume attackwise_attack-cache (mounted at
# /var/lib/attackwise/attack-cache); its path is fixed by compose.yaml.

# Same-origin deployment needs no CORS. Leave empty unless another site must call this API.
ATTACKWISE_FRONTEND_ORIGINS=

# --- Publishing (read by ./attackwise.sh / docker compose) -----------------------------------
# Mode "proxy" (default): an existing reverse proxy on this host terminates TLS and forwards to
# 127.0.0.1:8080 (see proxy/*.example). Mode "builtin": the web container serves HTTPS itself.
ATTACKWISE_TLS=proxy
ATTACKWISE_HTTP_BIND=127.0.0.1
ATTACKWISE_HTTP_PORT=8080

# Only for ATTACKWISE_TLS=builtin (then use ATTACKWISE_HTTP_BIND=0.0.0.0 and ATTACKWISE_HTTP_PORT=80
# so port 80 redirects to HTTPS):
# ATTACKWISE_HTTPS_BIND=0.0.0.0
# ATTACKWISE_HTTPS_PORT=443
# ATTACKWISE_TLS_CERT_DIR=</path/to/certificates>   # contains fullchain.pem and privkey.pem
